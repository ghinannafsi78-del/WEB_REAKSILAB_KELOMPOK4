# Konfigurasi Firebase REAKSI LAB
# Salin file ini menjadi .env.local dan isi nilai kredensial dari Firebase Console
# JANGAN PERNAH menyertakan file .env.local atau kredensial rahasia ke dalam repositori git

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

